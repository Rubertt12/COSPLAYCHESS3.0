{
  "name": "cosplay-chess-bluetooth-test",
  "version": "1.1.0",
  "description": "Cosplay Chess experimental com controle Bluetooth offline",
  "main": "experimental-bootstrap.js",
  "scripts": {
    "start": "electron .",
    "build": "echo 'Web Build Complete'",
    "dist": "electron-builder",
    "dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-installer-assets.ps1 && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "rimraf": "^5.0.7",
    "glob": "^10.3.15"
  },
  "author": "Rubra Studios",
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "pkg": "^5.8.1"
  },
  "build": {
    "appId": "com.rubra.cosplaychess.bluetooth-test",
    "productName": "Cosplay Chess Bluetooth Test",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "img/favicon/favicon.ico",
      "signAndEditExecutable": false,
      "forceCodeSigning": false,
      "artifactName": "Cosplay-Chess-Bluetooth-Test-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Cosplay Chess Bluetooth Test",
      "installerIcon": "img/favicon/favicon.ico",
      "uninstallerIcon": "img/favicon/favicon.ico",
      "installerLanguages": ["pt_BR"],
      "language": "1046",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "uninstallDisplayName": "Cosplay Chess Bluetooth Test"
    },
    "files": [
      "**/*",
      "!dist"
    ]
  }
}
